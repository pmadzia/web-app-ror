<%= turbo_frame_tag "users_list", data: { turbo_action: "advance" } do %>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th scope="col" style="width: 1%">
            <input type="checkbox" class="form-check-input"
                   aria-label="Select all users"
                   data-selection-target="all"
                   data-action="change->selection#toggleAll"
                   data-bs-toggle="tooltip" data-bs-title="Select / deselect all">
          </th>
          <th scope="col"><%= sort_link q, :full_name, "Name", controller: "admin", action: :index, user_ids: nil %></th>
          <th scope="col"><%= sort_link q, :email, "E-mail", controller: "admin", action: :index, user_ids: nil %></th>
          <th scope="col"><%= sort_link q, :status, "Status", controller: "admin", action: :index, user_ids: nil %></th>
          <th scope="col" class="text-nowrap"><%= sort_link q, :last_seen_or_epoch, "Last seen", controller: "admin", action: :index, user_ids: nil %></th>
        </tr>
      </thead>
      <tbody>
        <% users.each do |user| %>
          <% muted = user.blocked? ? "text-body-tertiary" : "" %>
          <tr>
            <td class="<%= muted %>">
              <input type="checkbox" class="form-check-input"
                     name="user_ids[]" value="<%= user.id %>" form="bulk_form"
                     aria-label="Select <%= user.full_name %>"
                     data-selection-target="row"
                     data-action="change->selection#update">
            </td>
            <td class="<%= muted %>">
              <div class="<%= 'text-decoration-line-through' if user.blocked? %>">
                <%= user.full_name %>
              </div>
              <div class="small opacity-75"><%= user.job_position.presence || "N/A" %></div>
            </td>
            <td class="<%= muted %>"><%= user.email %></td>
            <td class="<%= muted %>"><%= user.status.capitalize %></td>
            <td class="text-nowrap <%= muted %>">
              <% if user.last_seen %>
                <span data-bs-toggle="tooltip"
                      data-bs-title="<%= user.last_seen.strftime('%B %-d, %Y %H:%M:%S') %>">
                  <%= time_ago_in_words(user.last_seen) %> ago
                </span>
              <% else %>
                Never
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if users.empty? %>
          <tr><td colspan="5" class="text-center text-muted py-4">No users found.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>