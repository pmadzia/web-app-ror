<div class="row justify-content-center">
  <div class="col-12 col-sm-10 col-md-6 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 mb-3">Log in</h1>
        <%= form_with url: login_path do |f| %>
          <div class="mb-3">
            <%= f.label :email, "E-mail", class: "form-label" %>
            <%= f.email_field :email, value: params[:email], class: "form-control",
                              required: true, autofocus: true, autocomplete: "email" %>
          </div>
          <div class="mb-3">
            <%= f.label :password, "Password", class: "form-label" %>
            <%= f.password_field :password, class: "form-control",
                                 required: true, autocomplete: "current-password" %>
          </div>
          <%= f.submit "Log in", class: "btn btn-primary w-100" %>
        <% end %>
        <p class="mt-3 mb-0 text-center">
          No account yet? <%= link_to "Register", register_path %>
        </p>
      </div>
    </div>
  </div>
</div>