<div class="row justify-content-center">
  <div class="col-12 col-sm-10 col-md-8 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 mb-3">Register</h1>
        <%= form_with model: @user, url: register_path, method: :post do |f| %>
          <div class="mb-3">
            <%= f.label :full_name, "Full name", class: "form-label" %>
            <%= f.text_field :full_name, class: field_class(@user, :full_name),
                             required: true, autofocus: true %>
            <div class="invalid-feedback"><%= @user.errors.full_messages_for(:full_name).to_sentence %></div>
          </div>
          <div class="mb-3">
            <%= f.label :email, "E-mail", class: "form-label" %>
            <%= f.email_field :email, class: field_class(@user, :email),
                              required: true, autocomplete: "email" %>
            <div class="invalid-feedback"><%= @user.errors.full_messages_for(:email).to_sentence %></div>
          </div>
          <div class="mb-3">
            <%= f.label :job_position, "Job position (optional)", class: "form-label" %>
            <%= f.text_field :job_position, class: field_class(@user, :job_position) %>
          </div>
          <div class="mb-3">
            <%= f.label :password, "Password", class: "form-label" %>
            <%= f.password_field :password, class: field_class(@user, :password),
                                 required: true, autocomplete: "new-password" %>
            <div class="invalid-feedback"><%= @user.errors.full_messages_for(:password).to_sentence %></div>
          </div>
          <%= f.submit "Register", class: "btn btn-primary w-100" %>
        <% end %>
        <p class="mt-3 mb-0 text-center">
          Already registered? <%= link_to "Log in", login_path %>
        </p>
      </div>
    </div>
  </div>
</div>
